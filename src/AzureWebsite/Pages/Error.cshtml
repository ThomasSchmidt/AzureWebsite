@page
@model ErrorPageModel
@using AzureWebsite.Models
@{
    ViewData["Title"] = "Error";
}

<section class="section-card" aria-labelledby="error-title">
    <h1 id="error-title">Something went wrong</h1>
    <h2>We could not complete this request.</h2>

    @if (Model.ErrorInfo?.ShowRequestId == true)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.ErrorInfo.RequestId</code>
        </p>
    }

    <h3>Development mode</h3>
    <p>
        Running in <strong>Development</strong> shows more detailed exception information.
    </p>
    <p>
        <strong>Do not enable development mode in production</strong>. It can expose sensitive exception details.
        For local debugging, set <strong>ASPNETCORE_ENVIRONMENT</strong> to <strong>Development</strong> and restart the app.
    </p>
</section>
